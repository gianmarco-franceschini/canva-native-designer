        "jsCode": "const body = $input.first().json.body;\nconst fail = (message) => [{ json: { ok: false, statusCode: 400, body: { error: 'invalid_input', message } } }];\nconst EMAIL = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst normEmail = (e) => (typeof e === 'string' ? e.trim().toLowerCase() : '');\nconst isDate = (s) => typeof s === 'string' && !Number.isNaN(Date.parse(s));\nif (!body || typeof body !== 'object' || Array.isArray(body)) return fail('body mancante o non valido');\nconst calendarId = $vars.AGENDA_SHARED_CALENDAR_ID;\nif (typeof calendarId !== 'string' || calendarId.length === 0) {\n  return [{ json: { ok: false, statusCode: 500, body: { error: 'misconfigured' } } }];\n}\nif (typeof body.requestId !== 'string' || !/^[A-Za-z0-9-]{1,64}$/.test(body.requestId)) return fail('requestId');\nif (typeof body.googleEventId !== 'string' || !/^[A-Za-z0-9_-]{1,1024}$/.test(body.googleEventId)) return fail('googleEventId');\nreturn [{ json: { ok: true, calendarId, requestId: body.requestId, googleEventId: body.googleEventId } }];"

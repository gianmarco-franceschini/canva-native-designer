        "jsCode": "// Verifica firma HMAC: X-Signature = hex(HMAC-SHA256(secret, X-Timestamp + \".\" + rawBody)).\n// La funzione seguente è copiata identica da agenda-app/n8n/verify-signature.js\n// (stesso algoritmo di verifyRequest in agenda-app/src/lib/n8n/sign.ts).\nfunction verifyAgendaSignature(rawBody, secret, timestampMs, signature, nowMs) {\n  const crypto = require('crypto');\n  const MAX_SKEW_MS = 5 * 60 * 1000;\n  if (!Number.isFinite(timestampMs) || Math.abs(nowMs - timestampMs) > MAX_SKEW_MS) return false;\n  if (typeof signature !== 'string' || !/^[0-9a-f]{64}$/i.test(signature)) return false;\n  const expected = Buffer.from(\n    crypto.createHmac('sha256', secret).update(timestampMs + '.' + rawBody).digest('hex'),\n    'hex',\n  );\n  const given = Buffer.from(signature, 'hex');\n  if (expected.length !== given.length) return false;\n  return crypto.timingSafeEqual(expected, given);\n}\n\nconst item = $input.first();\nconst headers = item.json.headers || {};\nlet rawBody = '';\nconst bin = item.binary && item.binary.data;\nif (bin) {\n  try {\n    rawBody = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n  } catch (e) {\n    rawBody = Buffer.from(bin.data || '', 'base64').toString('utf8');\n  }\n}\nconst tsHeader = String(headers['x-timestamp'] ?? '');\nconst timestampMs = /^\\d{1,16}$/.test(tsHeader) ? Number(tsHeader) : NaN;\nconst signature = String(headers['x-signature'] ?? '');\nconst secret = $vars.AGENDA_WEBHOOK_SECRET;\nconst authorized =\n  typeof secret === 'string' &&\n  secret.length > 0 &&\n  verifyAgendaSignature(rawBody, secret, timestampMs, signature, Date.now());\nlet body = null;\nif (authorized) {\n  try {\n    body = JSON.parse(rawBody);\n  } catch (e) {\n    body = null; // firma valida ma JSON non valido: lo rifiuta \"Valida input\" con 400\n  }\n}\nreturn [{ json: { authorized, body } }];"

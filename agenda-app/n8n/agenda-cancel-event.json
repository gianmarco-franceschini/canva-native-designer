        "jsCode": "// Cancella solo eventi creati per questa richiesta; evento già rimosso = annullato (idempotente).\nconst calendarError = () => [{ json: { respond: true, statusCode: 502, body: { error: 'calendar_error' } } }];\nconst cancelled = () => [{ json: { respond: true, statusCode: 200, body: { status: 'cancelled' } } }];\nconst res = $input.first().json;\nconst v = $('Valida input').first().json;\nif (res.statusCode === 404 || res.statusCode === 410) return cancelled();\nif (res.statusCode !== 200 || !res.body) return calendarError();\nconst ev = res.body;\nconst owner = ev.extendedProperties && ev.extendedProperties.private\n  ? ev.extendedProperties.private.agendaRequestId\n  : undefined;\nif (owner === v.requestId) {\n  if (ev.status === 'cancelled') return cancelled();\n  return [{ json: { respond: false } }];\n}\nif (owner === undefined && ev.status === 'cancelled') return cancelled();\nreturn [{ json: { respond: true, statusCode: 403, body: { error: 'forbidden' } } }];"
